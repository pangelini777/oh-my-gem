{
  "name": "oh-my-gem",
  "version": "1.0.6",
  "description": "High-fidelity port of OMO agent orchestration to Gemini CLI.",
  "author": "Paolo Angelini",
  "license": "SUL-1.0",
  "homepage": "https://github.com/pangelini777/oh-my-gem",
  "sourceUrl": "https://github.com/pangelini777/oh-my-gem",
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "gh_grep": {
      "url": "https://mcp.grep.app"
    }
  },
  "contextFileName": "GEMINI.md"
}
